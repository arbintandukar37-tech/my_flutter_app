<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: App Title & Progress Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HabitFlow"
            android:textColor="#F0F0F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 of 5 done"
            android:textColor="#FFBE0B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Habit Row 1 -->
    <LinearLayout
        android:id="@+id/habit_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_habit_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Drink 2L Water"
            android:textColor="#F0F0F0"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_check_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_check_bg"
            android:src="@android:drawable/checkbox_on_background"
            android:contentDescription="Complete habit" />
    </LinearLayout>

    <!-- Habit Row 2 -->
    <LinearLayout
        android:id="@+id/habit_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_habit_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meditate"
            android:textColor="#F0F0F0"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_check_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_check_bg"
            android:src="@android:drawable/checkbox_off_background"
            android:contentDescription="Complete habit" />
    </LinearLayout>

    <!-- Habit Row 3 -->
    <LinearLayout
        android:id="@+id/habit_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_habit_3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read 30 pages"
            android:textColor="#F0F0F0"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_check_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_check_bg"
            android:src="@android:drawable/checkbox_off_background"
            android:contentDescription="Complete habit" />
    </LinearLayout>

</LinearLayout>
